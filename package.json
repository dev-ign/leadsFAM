{
  "name": "leadops-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "turbo run build --filter=@leadops/shared --filter=@leadops/ui && turbo run dev",
    "build": "turbo run build",
    "lint": "node scripts/check-boundaries.mjs && eslint . --max-warnings=0",
    "typecheck": "turbo run typecheck",
    "test": "node --test scripts/check-boundaries.test.mjs && turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:dependencies": "pnpm audit --audit-level=high",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
