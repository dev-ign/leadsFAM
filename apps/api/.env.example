NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# pnpm dev loads local Supabase configuration and generates session credentials
# outside this repository. No hosted credentials or .env edits are needed.
# Production must supply SUPABASE_URL, SUPABASE_PUBLIC_KEY (publishable/anon only),
# SESSION_DATABASE_URL (leadsfam_runtime, TLS), SESSION_ACTIVE_KEY, SESSION_KEYS
# (JSON key ID -> base64 32-byte key) through a reviewed secret manager.
# CRM_CURSOR_KEY must be a separate base64 32-byte HMAC key; never reuse a
# session encryption key. Rotation invalidates outstanding cursors only.
# ALLOW_ORG_CREATION defaults to false and cannot be true in production.

# AI assistance defaults to deterministic simulation; workspace enablement is separate.
# Real inference additionally requires reviewed provider data handling and explicit configuration.
AI_REAL_ENABLED=false
# AI_MODEL=<explicit-supported-structured-output-model>
# AI_API_KEY=<server-only-provider-key>
# AI_DATA_HANDLING_ACK=reviewed
# AI_DEADLINE_MS=15000
# AI_MAX_INPUT_BYTES=24000
# AI_MAX_OUTPUT_TOKENS=2400
# AI_MAX_RESPONSE_BYTES=32000
# Optional, all-or-nothing versioned cost estimates; use your approved current provider rates.
# AI_INPUT_USD_PER_MILLION=<nonnegative-rate>
# AI_OUTPUT_USD_PER_MILLION=<nonnegative-rate>
# AI_PRICING_VERSION=<approved-rate-version>

# Phase 06 synthetic evaluation only; never set in ordinary CI.
# AI_EVAL_LIVE=synthetic-only
# Candidate model and versioned prices must pass the evaluation before approval.
