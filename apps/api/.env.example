NODE_ENV=development
HOST=127.0.0.1
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# pnpm dev loads local Supabase configuration and generates session credentials
# outside this repository. No hosted credentials or .env edits are needed.
# Production must supply SUPABASE_URL, SUPABASE_PUBLIC_KEY (publishable/anon only),
# SESSION_DATABASE_URL (leadsfam_runtime, TLS), SESSION_ACTIVE_KEY, SESSION_KEYS
# (JSON key ID -> base64 32-byte key) through a reviewed secret manager.
# CRM_CURSOR_KEY must be a separate base64 32-byte HMAC key; never reuse a
# session encryption key. Rotation invalidates outstanding cursors only.
# ALLOW_ORG_CREATION defaults to false and cannot be true in production.
