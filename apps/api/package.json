{
  "name": "@leadops/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.16.1"
  },
  "scripts": {
    "dev": "node ../../scripts/dev-api.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@leadops/database": "workspace:*",
    "@leadops/shared": "workspace:*",
    "fastify": "5.12.7",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@leadops/config": "workspace:*",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
